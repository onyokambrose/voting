<div class="panel">
  <div class="panel-header">
    <h2>Add New Contestant</h2>
    <a href="/admin/dashboard" class="btn btn-ghost btn-sm">← Back</a>
  </div>

  <form method="POST" action="/admin/contestants" class="form-grid">
    <label>
      <span>Full Name *</span>
      <input name="name" placeholder="e.g. Jane Doe" required>
    </label>

    <label>
      <span>Category *</span>
      <select name="category" required>
        <option value="Mr">Mr</option>
        <option value="Miss">Miss</option>
      </select>
    </label>

    <label class="full">
      <span>Image URL</span>
      <input name="image" placeholder="https://... (leave blank for auto-avatar)">
    </label>

    <label class="full">
      <span>Short Bio</span>
      <textarea name="bio" rows="4" placeholder="A sentence or two about the contestant..."></textarea>
    </label>

    <div class="full form-actions">
      <a href="/admin/dashboard" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">Add Contestant</button>
    </div>
  </form>
</div>
