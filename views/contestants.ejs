<section class="page-header">
  <div class="container">
    <h1>Meet the Contestants</h1>
    <p>Vote once per day per email. Verified in seconds.</p>
    <div class="search-wrap">
      <input type="text" id="search" placeholder="🔍 Search by name..." autocomplete="off">
    </div>
  </div>
</section>

<% if (!status.open) { %>
  <div class="container" style="margin-top:1.5rem;">
    <div class="alert alert-error" style="background:#fef2f2;color:#b91c1c;padding:1rem 1.25rem;border-radius:12px;border:1px solid #fecaca;">
      ⏳ <strong><%= status.reason %></strong>
      <% if (status.closes) { %> · Closes <%= new Date(status.closes).toLocaleString() %><% } %>
    </div>
  </div>
<% } %>

<section class="section">
  <div class="container">
    <% const mrs = contestants.filter(c => c.category === 'Mr'); %>
    <% const misss = contestants.filter(c => c.category === 'Miss'); %>

    <% function renderGrid(list, colorBg) { %>
      <div class="grid" data-grid>
        <% list.forEach(c => { %>
          <div class="card" data-name="<%= c.name.toLowerCase() %>">
            <div class="card-media">
              <img 
                src="<%= c.image || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(c.name) + '&size=400&background=' + colorBg + '&color=fff' %>" 
                alt="<%= c.name %>"
                onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(c.name) %>&size=400&background=f97316&color=fff';"
              >
              <span class="badge <%= c.category %>"><%= c.category %></span>
            </div>
            <div class="card-body">
              <h3 class="card-title"><%= c.name %></h3>
              <p class="card-bio"><%= c.bio || 'No bio yet.' %></p>
              <div class="card-footer">
                <span class="votes-count" data-id="<%= c.id %>"><%= c.votes %> votes</span>
                <div class="card-btns">
                  <button class="icon-btn" onclick="shareContestant('<%= c.name %>', <%= c.id %>)" title="Share">🔗</button>
                  <button class="btn btn-primary btn-sm" onclick="vote(<%= c.id %>)" <%= status.open ? '' : 'disabled' %>>Vote</button>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (mrs.length) { %>
      <h2 class="category-title"><span class="dot mr-dot"></span> Mr</h2>
      <% renderGrid(mrs, '0ea5e9'); %>
    <% } %>

    <% if (misss.length) { %>
      <h2 class="category-title" style="margin-top:3rem;"><span class="dot miss-dot"></span> Miss</h2>
      <% renderGrid(misss, 'ec4899'); %>
    <% } %>

    <% if (contestants.length === 0) { %>
      <p class="empty">No contestants yet. Check back soon!</p>
    <% } %>
  </div>
</section>

<!-- Email modal -->
<div id="email-modal" class="modal-backdrop" style="display:none;">
  <div class="modal">
    <button class="modal-close" onclick="closeEmailModal()">×</button>
    <h2>One vote per day</h2>
    <p class="muted">Enter your email. We'll send a 6-digit code to confirm your vote.</p>
    <div class="form" style="margin-top:1.25rem;">
      <input type="email" id="voter-email" placeholder="you@example.com" autocomplete="email">
      <button class="btn btn-primary btn-block" onclick="sendOtp()">Send Code</button>
    </div>
    <p class="muted small" style="margin-top:1rem;text-align:center;">
      🔒 We only use your email to prevent duplicate votes.
    </p>
  </div>
</div>
