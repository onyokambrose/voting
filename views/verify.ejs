<section class="page-header">
  <div class="container">
    <h1>Verify Your Email</h1>
    <p>We sent a 6-digit code to <strong><%= email %></strong></p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width: 480px;">
    <div class="panel" style="padding: 2rem; background: var(--card); border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow);">
      <div id="otp-box" class="otp-box">
        <input type="text" id="otp" maxlength="6" inputmode="numeric" placeholder="••••••" class="otp-input" autofocus>
        <button class="btn btn-primary btn-block" onclick="verifyOtp()">Verify Code</button>
        <p class="muted small" style="text-align:center;margin-top:1rem;">
          Didn't get it? <a href="/contestants" style="color:var(--primary);font-weight:600;">Resend</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
async function verifyOtp() {
  const code = document.getElementById('otp').value.trim();
  if (code.length !== 6) return showToast('Enter the 6-digit code', 'error');
  const res = await fetch('/auth/verify', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ code })
  });
  const data = await res.json();
  showToast(data.message, data.success ? 'success' : 'error');
  if (data.success) {
    burstConfetti();
    setTimeout(() => location.href = '/contestants', 900);
  }
}
document.getElementById('otp').addEventListener('keydown', e => {
  if (e.key === 'Enter') verifyOtp();
});
</script>
